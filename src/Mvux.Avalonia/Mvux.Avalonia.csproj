<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>Mvux.Avalonia</PackageId>
    <Description>Mvux.Avalonia — Uno MVUX pattern for Avalonia. Includes FeedView control and source generator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <ProjectReference Include="..\Mvux.Core\Mvux.Core.csproj" />

    <ProjectReference Include="..\Mvux.Avalonia.Generators\Mvux.Avalonia.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Mvux.Avalonia.Generators\Mvux.Avalonia.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorDll" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_GeneratorDll)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
