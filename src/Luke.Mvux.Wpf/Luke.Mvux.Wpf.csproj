<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <AssemblyName>Luke.Mvux.Wpf</AssemblyName>
    <RootNamespace>Luke.Mvux.Wpf</RootNamespace>
    <PackageId>Luke.Mvux.Wpf</PackageId>
    <Description>Luke.Mvux.Wpf — MVUX pattern for WPF. Includes FeedView control and source generator.</Description>
    <PackageProjectUrl>https://github.com/lukewire129/MVUX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lukewire129/MVUX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>iocn.png</PackageIcon>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>

    <MvuxGeneratorPath>..\Luke.Mvux.Generators\bin\$(Configuration)\netstandard2.0\Luke.Mvux.Generators.dll</MvuxGeneratorPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\iocn.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Core: Debug는 일반 참조, Release는 패키지에 내장 -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Luke.Mvux\Luke.Mvux.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <ProjectReference Include="..\Luke.Mvux\Luke.Mvux.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Generator: 빌드 의존성 보장 (DLL 생성), 런타임 참조 없음 -->
  <ItemGroup>
    <ProjectReference Include="..\Luke.Mvux.Generators\Luke.Mvux.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Generator DLL을 패키지 analyzers/dotnet/cs/ 에 직접 포함 -->
  <ItemGroup>
    <None Include="$(MvuxGeneratorPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- Core DLL을 패키지 lib 폴더에 내장 -->
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>
