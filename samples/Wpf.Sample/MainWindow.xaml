<Window x:Class="Wpf.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Lw.Mvux.Wpf;assembly=Lw.Mvux.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Wpf.Sample"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Weather — MVUX.Wpf" Height="680" Width="460"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,24,20,24">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <materialDesign:PackIcon Kind="WeatherPartlyCloudy"
                                         Width="32" Height="32"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="Weather Sample"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- City Search Card -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SEARCH"
                               Style="{StaticResource MaterialDesignOverlineTextBlock}"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Enter city name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding RefreshCommand, ElementName=WeatherFeed}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- FeedView: Loading / Data / Error -->
            <lib:FeedView x:Name="WeatherFeed" Source="{Binding CurrentWeather}" Margin="0,0,0,16">

                <lib:FeedView.LoadingTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="40">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True"
                                             Width="48" Height="48"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16"/>
                                <TextBlock Text="Fetching weather data..."
                                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.LoadingTemplate>

                <lib:FeedView.FeedDataTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Data.City}"
                                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Margin="0,8,0,4">
                                    <Run Text="{Binding Data.Temperature, Mode=OneWay}"
                                         FontSize="64" FontWeight="Light"/>
                                    <Run Text="°C" FontSize="28" FontWeight="Light"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherCloudy"
                                                             VerticalAlignment="Center"
                                                             Opacity="0.6"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Data.Condition}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                                               VerticalAlignment="Center"
                                               Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.FeedDataTemplate>

                <lib:FeedView.ErrorTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Error.Message}"
                                               Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="RETRY"
                                        Command="{Binding Refresh}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.ErrorTemplate>

            </lib:FeedView>

            <!-- Favorites Card -->
            <materialDesign:Card Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="StarOutline"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Favorites"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListView ItemsSource="{Binding FavoritesWithSelection}"
                              MaxHeight="160" MinHeight="40"
                              Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="MapMarkerCheck"
                                                 Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Opacity="0.6"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   VerticalAlignment="Center">
                            <Run Text="Selected: " Foreground="Gray"/>
                            <Run Text="{Binding SelectedFavorite}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddFavorite}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StarPlus" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Favorite" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding GoToSelected}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerRight" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Go to Selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>

</Window>
