<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalonia.WhenSelected.Sample.MainWindow"
        Title="WhenSelected - Avalonia"
        Width="760" Height="480"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20" ColumnDefinitions="1.2*,20,*">
        <StackPanel Grid.Column="0">
            <TextBlock Text="Cities" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="No SelectedItem binding. Selection sync comes from ListFeed.Value(...).WhenSelected(...)."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12" />

            <ListBox ItemsSource="{Binding Cities}"
                     MinHeight="220"
                     SelectionMode="Single" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Selected State" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Border Background="#EEF4FF" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedCity, FallbackValue=(none)}" FontSize="18" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding SelectBusan}">Select Busan</Button>
                <Button Command="{Binding ClearSelection}">Clear</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
