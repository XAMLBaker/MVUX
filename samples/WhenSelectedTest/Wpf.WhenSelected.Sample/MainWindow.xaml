<Window
    x:Class="Wpf.WhenSelected.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhenSelected - WPF"
    Width="760"
    Height="480">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Cities" />
            <TextBlock
                Margin="0,0,0,12"
                Opacity="0.7"
                Text="No SelectedItem binding. Selection sync comes from ListFeed.Value(...).WhenSelected(...)."
                TextWrapping="Wrap" />

            <ListBox
                MinHeight="220"
                ItemsSource="{Binding Cities}"
                SelectionMode="Single" />
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Selected State" />
            <Border
                Margin="0,0,0,12"
                Padding="12"
                Background="#EEF4FF"
                CornerRadius="8">
                <TextBlock FontSize="18" Text="{Binding SelectedCity, FallbackValue=(none)}" />
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding SelectBusan}"
                    Content="Select Busan" />
                <Button Command="{Binding ClearSelection}" Content="Clear" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
