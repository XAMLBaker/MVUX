<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalonia.MultiSelection.Sample.MainWindow"
        Title="Multi Selection - MVUX.Avalonia"
        Width="1240" Height="780"
        WindowStartupLocation="CenterScreen">

    <Window.Background>#F3F6FB</Window.Background>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#D9E1EE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#5D6C83" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1A2A43" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#EAF1FB" />
            <Setter Property="Foreground" Value="#183A66" />
            <Setter Property="BorderBrush" Value="#C2D5F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#D7E7FA" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2D6BCF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2459AB" />
        </Style>
    </Window.Styles>

    <Grid Margin="22" RowDefinitions="Auto,Auto,*">
        <Border Classes="card" Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="▣" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel MaxWidth="800">
                        <TextBlock Text="Multi-selection sample" Classes="section-title" />
                        <TextBlock Text="Use Ctrl or Shift to select several cards. The panel on the right mirrors selected state, and the buttons can push a recommended set back into the UI." Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#EEF4FF" CornerRadius="14" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Selected" Classes="muted" />
                        <TextBlock Text="{Binding SelectedCardItems.Count, FallbackValue=0}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Classes="card" Grid.Row="1" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Watermark="New queue card title" Text="{Binding DraftTitle}" Margin="0,0,12,0" />
                <Button Grid.Column="1" Command="{Binding AddCard}" Margin="0,0,8,0">Add</Button>
                <Button Grid.Column="2" Command="{Binding SelectRecommended}" Margin="0,0,8,0">Select Recommended</Button>
                <Button Grid.Column="3" Command="{Binding PromoteSelected}" Margin="0,0,8,0">Promote Selected</Button>
                <Button Grid.Column="4" Command="{Binding CompleteSelected}">Complete Selected</Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.3*,16,0.9*">
            <Border Classes="card" Grid.Column="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Queue (SelectionMode=Multiple, no SelectedItems binding)" Classes="section-title" Margin="0,0,0,12" />
                    <ListBox x:Name="QueueList" ItemsSource="{Binding QueueWithSelection}" SelectionMode="Multiple" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" Background="#F7FAFF" CornerRadius="12" BorderBrush="#D5E1F3" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Margin="0,4,0,0" Classes="muted">
                                                <Run Text="{Binding Id}" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding Owner}" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding Lane}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#DFF1E5" CornerRadius="10" Padding="8,4" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Escalated}" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Classes="card" Grid.Column="2">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Mirrored Selection State" Classes="section-title" />
                        <TextBlock Text="This list is bound directly to the generated SelectedCards property. Programmatic selection updates here and syncs back into the queue control." Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedCardItems}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" Background="#F7FAFF" CornerRadius="10" BorderBrush="#D5E1F3" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Classes="muted">
                                            <Run Text="{Binding Id}" />
                                            <Run Text="  •  " />
                                            <Run Text="{Binding Owner}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Command="{Binding ClearSelection}" Classes="primary">Clear Selection</Button>
                        <TextBlock Text="Removing cards also prunes stale selections automatically." Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
