<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Luke.Mvux.Avalonia;assembly=Luke.Mvux.Avalonia"
        xmlns:local="clr-namespace:Avalonia.Demo.Sample"
        x:Class="Avalonia.Demo.Sample.MainWindow"
        Title="MVUX Operations Board (Avalonia)"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:LanguageTextConverter x:Key="Lang"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="card">
            <Grid ColumnDefinitions="Auto,* ,Auto">
                <TextBlock Grid.Column="0" Text="OPS" FontSize="30" FontWeight="Bold" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Operations Board Demo|운영 보드 데모'}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Classes="muted" Text="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Selection sync + FeedView state rendering + command-driven updates.|Selection 동기화 + FeedView 상태 렌더링 + 명령 기반 업데이트'}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button VerticalAlignment="Center"
                            Command="{Binding ToggleLanguage}"
                            Content="ENG / KOR"/>
                    <Button VerticalAlignment="Center"
                            Command="{Binding RefreshCommand, ElementName=InsightFeed}"
                            Content="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Refresh Insight|인사이트 새로고침'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0"
                         Watermark="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='New work item title|새 작업 제목'}"
                         Text="{Binding DraftTitle}"
                         Margin="0,0,10,0" />
                <Button Grid.Column="1" Content="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Add|추가'}" Command="{Binding AddWorkItem}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Resolve Selected|선택 항목 해결'}" Command="{Binding ResolveSelected}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Simulate Failure|실패 시뮬레이션'}" Command="{Binding SimulateFailure}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.2*,16,1*">
            <Border Grid.Column="0" Classes="card" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="6,0,6,10"
                               Text="{Binding Language, Converter={StaticResource Lang}, ConverterParameter='Queue (SelectedItem binding not required)|큐 (SelectedItem 바인딩 불필요)'}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding QueueWithSelection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="•"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="muted">
                                            <Run Text="{Binding Id}"/>
                                            <Run Text="  |  "/>
                                            <Run Text="{Binding Team}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Priority}" Opacity="0.75" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <lib:FeedView Grid.Column="2" x:Name="InsightFeed" Source="{Binding SelectedInsight}">
                <lib:FeedView.NoneTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Select a queue item|큐에서 항목을 선택하세요'}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Insight feed starts from the selected item.|인사이트 피드는 선택 항목에서 시작됩니다.'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </lib:FeedView.NoneTemplate>

                <lib:FeedView.LoadingTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,12"/>
                                <TextBlock Classes="muted" Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Analyzing selected work item...|선택된 작업 항목을 분석 중...'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </lib:FeedView.LoadingTemplate>

                <lib:FeedView.ErrorTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Insight Fetch Failed|인사이트 조회 실패'}" Foreground="IndianRed" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Error.Message}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Retry|다시 시도'}" Command="{Binding Refresh}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </lib:FeedView.ErrorTemplate>

                <lib:FeedView.FeedDataTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Selected Insight|선택된 인사이트'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Data.Id}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Data.Summary}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <TextBlock Text="{Binding Data.Recommendation}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock>
                                    <Run Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Risk Score: |위험 점수: '}"/>
                                    <Run Text="{Binding Data.RiskScore}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Escalate: |에스컬레이션: '}"/>
                                    <Run Text="{Binding Data.Escalate}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Classes="muted" Margin="0,12,0,0"
                                           Text="{Binding Parent.Language, Converter={StaticResource Lang}, ConverterParameter='Tip: use Simulate Failure to verify ErrorTemplate and retry flow.|팁: 실패 시뮬레이션으로 ErrorTemplate과 재시도 흐름을 확인하세요.'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </lib:FeedView.FeedDataTemplate>
            </lib:FeedView>
        </Grid>
    </Grid>
</Window>
