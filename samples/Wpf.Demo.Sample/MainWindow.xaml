<Window x:Class="Wpf.Demo.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Luke.Mvux.Wpf;assembly=Luke.Mvux.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="MVUX Operations Board" Height="740" Width="1200"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="32" Height="32" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Operations Board Demo" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <TextBlock Text="Shows Selection, FeedView states, and command-driven list updates." Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding RefreshCommand, ElementName=InsightFeed}"
                        Content="Refresh Insight"/>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         materialDesign:HintAssist.Hint="New work item title"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,12,0"
                         Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding AddWorkItem}" Content="Add"/>
                <Button Grid.Column="2" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ResolveSelected}" Content="Resolve Selected"/>
                <Button Grid.Column="3"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding SimulateFailure}" Content="Simulate Failure"/>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="8"
                               Text="Queue (selection sync without SelectedItem binding)"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                    <ListView ItemsSource="{Binding QueueWithSelection}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="AlertOutline"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Critical"><Setter Property="Kind" Value="AlertCircle"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="High"><Setter Property="Kind" Value="Alert"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Medium"><Setter Property="Kind" Value="ClockOutline"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Low"><Setter Property="Kind" Value="CheckCircleOutline"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Opacity="0.65">
                                            <Run Text="{Binding Id}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding Team}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Priority}" VerticalAlignment="Center" Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </materialDesign:Card>

            <lib:FeedView Grid.Column="2" x:Name="InsightFeed" Source="{Binding SelectedInsight}">
                <lib:FeedView.NoneTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CursorDefaultClickOutline" Width="40" Height="40" Opacity="0.5" Margin="0,0,0,10"/>
                                <TextBlock Text="Pick a work item from the queue" Opacity="0.7"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.NoneTemplate>

                <lib:FeedView.LoadingTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="30">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="52" Height="52" Margin="0,0,0,12"/>
                                <TextBlock Text="Analyzing selected work item..." Opacity="0.7"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.LoadingTemplate>

                <lib:FeedView.ErrorTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="22">
                            <StackPanel>
                                <TextBlock Text="Insight Fetch Failed" Foreground="IndianRed" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Error.Message}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Retry" Command="{Binding Refresh}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.ErrorTemplate>

                <lib:FeedView.FeedDataTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="18">
                            <StackPanel>
                                <TextBlock Text="Selected Insight" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Data.Id}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Data.Summary}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <TextBlock Text="{Binding Data.Recommendation}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                                <TextBlock>
                                    <Run Text="Risk Score: "/>
                                    <Run Text="{Binding Data.RiskScore}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Escalate: "/>
                                    <Run Text="{Binding Data.Escalate}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Margin="0,12,0,0" Opacity="0.6" FontSize="12"
                                           Text="Tip: click Simulate Failure to see ErrorTemplate, then Refresh."/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </lib:FeedView.FeedDataTemplate>
            </lib:FeedView>
        </Grid>
    </Grid>
</Window>
